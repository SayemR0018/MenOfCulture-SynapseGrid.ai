# LLM provider selection. One of: mock | openai | anthropic
# "mock" is a deterministic offline rule-based provider used for local
# development and tests. It does NOT satisfy the competition's requirement
# that a real LLM be part of the interpretation path -- set this to
# "openai" or "anthropic" with a real API key before deploying/submitting.
MODEL_PROVIDER=mock

# Provider-specific model id, e.g. gpt-4o-mini (openai) or
# claude-sonnet-5 (anthropic). Ignored by the mock provider.
MODEL_NAME=gpt-4o-mini

# Secret API key for the configured provider. Never commit a real value.
API_KEY=

# Optional: override the API base URL (e.g. for an OpenAI-compatible proxy).
API_BASE_URL=

# Max correction retries after the first failed validation (Section 23
# recommends 1-2).
MAX_RETRIES=1

# Python logging level.
LOG_LEVEL=INFO
